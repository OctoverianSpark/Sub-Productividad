# Copiar como .env y completar. Nunca subir .env al repositorio.

# URL publica de la aplicacion (sin "/" final). Se usa para el redirect de Google OAuth.
APP_URL=https://subpro.ejemplo.com

# true en produccion (HTTPS). Poner false solo en desarrollo local sin HTTPS.
SESSION_SECURE=true

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=subp

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Active Directory
# Usar una cuenta de servicio de solo lectura, NO la cuenta Administrador del dominio.
AD_ACCOUNT_SUFFIX=@asistentevirtualsas.com
AD_DOMAIN_CONTROLLERS=AV-SRV-DC1.asistentevirtualsas.com
AD_BASE_DN=dc=AsistenteVirtualSAS,dc=com
AD_ADMIN_USERNAME=
AD_ADMIN_PASSWORD=
